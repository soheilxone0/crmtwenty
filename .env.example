APP_NAME='CRM'
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.arounidea.com
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_CURRENCY=IRR

VITE_HOST=
VITE_PORT=

CORS_ALLOWED_ORIGINS=

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Supported: mysql, mariadb
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Company e-mail can also be set from the admin panel:
# Configuration → Email → Company e-mail (پیکربندی ← ایمیل ← ایمیل شرکت).
# Values saved there override the ones below.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=crm@arounidea.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_DOMAIN=arounidea.com

MAIL_RECEIVER_DRIVER=sendgrid
MAIL_RECEIVER_INBOUND_TOKEN=

IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=your_username
IMAP_PASSWORD=your_password

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

NOTIFICATION_DRIVER=polling
NOTIFICATION_POLL_INTERVAL=30

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

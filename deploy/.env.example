# ================= crmtwenty settings / تنظیمات =================
# این فایل را به نام .env کپی کنید و مقادیر را تغییر دهید.
# Copy to .env and edit. `bash setup-server.sh --env-only` fills the secrets.

# آدرس عمومی سایت (دقیقاً همانی که کاربران در مرورگر باز می‌کنند)
SERVER_URL=https://crm.example.com

# دامنه برای HTTPS خودکار با Caddy (فقط وقتی COMPOSE_PROFILES=https باشد)
DOMAIN=crm.example.com
# برای فعال کردن HTTPS خودکار خط زیر را از حالت کامنت خارج کنید.
# Leave commented out if you already use nginx / another reverse proxy.
#COMPOSE_PROFILES=https

# پورت داخلی برنامه. با 127.0.0.1 فقط از طریق reverse proxy در دسترس است.
# Use HTTP_BIND=0.0.0.0 to expose port 3000 directly (no proxy).
HTTP_BIND=127.0.0.1
HTTP_PORT=3000

# ایمیج داکر (به‌صورت خودکار توسط GitHub Actions تنظیم می‌شود)
TWENTY_IMAGE=ghcr.io/soheilxone0/crmtwenty:latest

# رمزها — حتماً مقدار تصادفی بگذارید (openssl rand -base64 32 ؛ برای رمز دیتابیس: openssl rand -hex 24)
APP_SECRET=replace_me_with_a_random_string
ENCRYPTION_KEY=replace_me_with_a_random_string
PG_DATABASE_PASSWORD=replace_me_with_random_hex_without_special_characters

# پایگاه داده
PG_DATABASE_USER=postgres
PG_DATABASE_NAME=default

# فایل‌ها: local یا s3
STORAGE_TYPE=local

# اگر می‌خواهید چند شرکت/فضای کاری مجزا داشته باشید true کنید
IS_MULTIWORKSPACE_ENABLED=false

# ایمیل (برای دعوت کاربران و بازیابی رمز). EMAIL_DRIVER=SMTP برای ارسال واقعی.
EMAIL_DRIVER=LOGGER
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=CRM
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
